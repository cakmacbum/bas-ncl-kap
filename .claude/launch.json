{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "pressure-vessel-suite/apps/web-ui",
      "port": 5173
    },
    {
      "name": "landing",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "4321", "--bind", "127.0.0.1"],
      "cwd": "pressure-vessel-suite/apps/landing",
      "port": 4321
    },
    {
      "name": "api",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "apps.api.main:app", "--port", "8000", "--env-file", ".env"],
      "cwd": "pressure-vessel-suite",
      "port": 8000,
      "env": {
        "CORS_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:4322,http://localhost:4322"
      }
    },
    {
      "name": "test-ortami",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "4322", "--bind", "127.0.0.1"],
      "cwd": "pressure-vessel-suite/tools/test-ortami",
      "port": 4322
    }
  ]
}
