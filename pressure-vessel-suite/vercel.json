{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd apps/web-ui && npm ci",
  "buildCommand": "cd apps/web-ui && npm run build",
  "outputDirectory": "apps/web-ui/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{apps/__init__.py,apps/api/**,packages/*/src/**,standards/**}",
      "excludeFiles": "{tests/**,**/tests/**,**/__pycache__/**,**/*.pyc,output/**,apps/web-ui/**,apps/landing/**,docs/**,tools/**,**/node_modules/**,**/.pytest_cache/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/|assets/|.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
      ]
    }
  ]
}
